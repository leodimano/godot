config_version=5

[application]
config/name="Precompiled GDScript"
run/main_scene="res://main.tscn"

[autoload]
Startup="*res://startup.gd"

[display]
window/size/viewport_width=800
window/size/viewport_height=450

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.09, 0.14, 1)
