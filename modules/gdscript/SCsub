#!/usr/bin/env python
from misc.utility.scons_hints import *

import gdscript_bytecode_builders

Import("env")
Import("env_modules")

env_gdscript = env_modules.Clone()

# Host and target use the same source identity, independent of CPU or whether
# the target includes the source compiler. Native bindings are checked at load.
compatibility_sources = Glob("*.cpp") + Glob("*.h") + Glob("#core/variant/*.cpp") + Glob("#core/variant/*.h")
compatibility_sources += Glob("editor/gdscript_bytecode_*.cpp") + Glob("editor/gdscript_bytecode_*.h")
compatibility_sources = [source for source in compatibility_sources if ".gen." not in source.name]
compatibility_sources += [
    File("#core/math/math_defs.h"),
    File("#version.py"),
    File("SCsub"),
    File("gdscript_bytecode_builders.py"),
]
compatibility_fingerprint = gdscript_bytecode_builders.fingerprint_files([
    source.abspath for source in compatibility_sources
])
# A Value dependency avoids a C/C++ include-scanner cycle through this header.
env.CommandNoCache(
    "gdscript_bytecode_compatibility.gen.h",
    env.Value(compatibility_fingerprint),
    env.Run(gdscript_bytecode_builders.make_compatibility_header),
)

sources = Glob("*.cpp")
if not env["gdscript_compiler"]:
    compiler_sources = {
        "gdscript_analyzer.cpp",
        "gdscript_byte_codegen.cpp",
        "gdscript_compiler.cpp",
        "gdscript_parser.cpp",
        "gdscript_tokenizer.cpp",
        "gdscript_tokenizer_buffer.cpp",
        "gdscript_warning.cpp",
    }
    sources = [source for source in sources if source.name not in compiler_sources]
env_gdscript.add_source_files(env.modules_sources, sources)

if env.editor_build:
    env_gdscript.add_source_files(env.modules_sources, "./editor/*.cpp")

    SConscript("editor/script_templates/SCsub")

    # Those two modules are required for the language server protocol
    if env["module_jsonrpc_enabled"] and env["module_websocket_enabled"]:
        env_gdscript.add_source_files(env.modules_sources, "./language_server/*.cpp")
    else:
        # Using a define in the disabled case, to avoid having an extra define
        # in regular builds where all modules are enabled.
        env_gdscript.Append(CPPDEFINES=["GDSCRIPT_NO_LSP"])
        # Also needed in main env to unexpose --lsp-port option.
        env.Append(CPPDEFINES=["GDSCRIPT_NO_LSP"])


if env["tests"] and env["gdscript_compiler"]:
    # TODO: Handle test creation magic without needing to pass macro.
    env_gdscript.Append(CPPDEFINES=["TESTS_ENABLED"])
    env_gdscript.add_source_files(env.modules_sources, "./tests/*.cpp")
